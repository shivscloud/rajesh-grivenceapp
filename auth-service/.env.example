# Copy to .env for local `python app.py` runs (docker-compose / k8s inject these as real env vars instead)
MONGO_URI=mongodb://root:example@localhost:27017/
MONGO_DB=auth_db
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRY_HOURS=24
AUDIT_SERVICE_URL=http://localhost:5003
PORT=5001
FLASK_ENV=development
